        "h3u1": {
          "place": "At the station",
          "lines": [
            [
              "梅",
              "你好！欢迎来到杭州。",
              "Hello! Welcome to Hangzhou."
            ],
            [
              "你",
              "谢谢你来接我。",
              "Thanks for coming to pick me up."
            ]
