          "tile": "autumn"
        },
        "h3u2": {
          "place": "At the supermarket",
          "lines": [
            [
              "梅",
              "你要买多少水果？",
              "How much fruit do you want to buy?"
            ],
            [
              "你",
              "我要两公斤苹果。",
              "I want two kilos of apples."
            ]
          ],
          "tile": "autumn2"
        },
        "h3u3": {
          "place": "First week",
          "lines": [
            [
              "梅",
              "今天几号？",
              "What is the date today?"
            ],
            [
              "你",
              "十月十号。秋天来了。",
              "The tenth of October. Autumn has come."
            ]
          ],
          "tile": "autumn"
        },
        "h3u4": {
          "place": "In the library",
          "lines": [
            [
              "梅",
              "你每天学习多长时间？",
              "How long do you study every day?"
            ],
            [
              "你",
              "我每天学习一个小时。",
              "I study for an hour every day."
            ]
          ],
          "tile": "autumn2"
        },
        "h3u5": {
          "place": "A restaurant",
          "lines": [
            [
              "梅",
              "我们去吃杭州菜吧。",
              "Let's go and eat Hangzhou food."
            ],
            [
              "你",
              "好，我想吃鱼和米饭。",
              "Good, I would like fish and rice."
