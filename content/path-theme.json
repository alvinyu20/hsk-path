        "h3u15": {
          "place": "Talking about later",
          "lines": [
            [
              "梅",
              "你以后会再来吗？",
              "Will you come again someday?"
            ],
            [
              "你",
              "我一定会再来。",
              "I will definitely come again."
            ]
          ],
          "tile": "spring"
        },
        "h3u16": {
          "place": "Weekend plans",
          "lines": [
            [
              "梅",
              "如果明天不下雨，我们去哪里？",
              "If it does not rain tomorrow, where shall we go?"
            ],
            [
              "你",
              "为了看花，我们去公园吧。",
              "To see the flowers, let's go to the park."
            ]
          ],
          "tile": "spring2"
        },
        "h3u17": {
          "place": "Last day",
          "lines": [
            [
              "梅",
              "你不但会说汉语，而且写得很好。",
              "You not only speak Chinese, you write it well too."
            ],
            [
              "你",
              "谢谢你一直帮我！",
              "Thank you for always helping me!"
            ]
          ],
          "tile": "spring"
        }
