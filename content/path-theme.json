        "h3u11": {
          "place": "A cold week",
          "lines": [
            [
              "梅",
              "你怎么了？",
              "What is wrong?"
            ],
            [
              "你",
              "我有点发烧，头也疼。",
              "I have a bit of a fever, and a headache too."
            ]
          ],
          "tile": "winter"
        },
        "h3u12": {
          "place": "Café talk",
          "lines": [
            [
              "梅",
              "你觉得汉语难吗？",
              "Do you think Chinese is hard?"
